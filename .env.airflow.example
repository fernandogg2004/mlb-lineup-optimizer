# Copiar a `.env` (junto a docker-compose.airflow.yml) y ajustar los valores.
# docker compose lee automáticamente el fichero .env del directorio.

# UID del proceso de Airflow (en Linux: pon tu `id -u` para evitar problemas de
# permisos en logs/. En Windows/Mac con Docker Desktop, 50000 está bien).
AIRFLOW_UID=50000

# Credenciales de la UI de Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Ruta ABSOLUTA del proyecto en el HOST. La usan los DAGs para montar el código y
# persistir data/, models/, results/, reports/ del pipeline en el host (los mismos
# que lee tu frontend/API en local).
#   Linux/Mac : /home/usuario/MLB-AI
#   Windows   : C:\Users\ferna\Desktop\MLB AI
HOST_PROJECT_DIR=/ruta/absoluta/al/proyecto

# Imagen del pipeline (construida con docker/Dockerfile.pipeline)
PIPELINE_IMAGE=mlb-pipeline:latest

# Opcional: necesaria sólo para las explicaciones LLM (War Room / RAG)
ANTHROPIC_API_KEY=
