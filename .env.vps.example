# =============================================================================
# MLB AI — Variables de entorno para producción (VPS)
# Copia a .env y rellena todos los valores marcados con CAMBIAR_
#
#   cp .env.vps.example .env
#   nano .env
# =============================================================================

# --- PostgreSQL MLB predictions ---
POSTGRES_HOST=postgres-mlb
POSTGRES_PORT=5432
POSTGRES_DB=mlb_predictions
POSTGRES_USER=mlb
POSTGRES_PASSWORD=CAMBIAR_password_seguro_aqui

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_PASSWORD=CAMBIAR_password_admin_airflow
AIRFLOW_ADMIN_EMAIL=fernando.ditos@gmail.com

# Generar con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CAMBIAR_fernet_key

# Generar con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=CAMBIAR_secret_key

# --- MLB Stats API (público, no requiere key) ---
MLB_STATS_API_BASE=https://statsapi.mlb.com/api/v1

# --- Slack (opcional — dejar vacío para deshabilitar alertas) ---
SLACK_WEBHOOK_URL=

# --- AWS (requerido para pipeline de retraining via S3) ---
# Sin estas credenciales, mlb_gameday_orchestrator funciona igualmente.
# Solo mlb_daily_pipeline (Statcast ingestion) las requiere.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=mlb-ai-datalake

# --- Modelo ---
MODEL_VERSION=1.0.0

# --- MLflow (opcional) ---
MLFLOW_TRACKING_URI=
