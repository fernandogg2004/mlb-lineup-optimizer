{
  "_comment": "IAM Policy de mínimo privilegio para el ECS Task Role del servicio de inferencia.",
  "_note": "Aplicar con: aws iam create-policy --policy-name mlb-ai-inference-policy --policy-document file://inference_role_policy.json",

  "Version": "2012-10-17",
  "Statement": [

    {
      "Sid": "S3ReadSilverGoldModels",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:HeadObject"
      ],
      "Resource": [
        "arn:aws:s3:::mlb-ai-datalake/silver/*",
        "arn:aws:s3:::mlb-ai-datalake/gold/*",
        "arn:aws:s3:::mlb-ai-datalake/models/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:prefix": ["silver/", "gold/", "models/"]
        }
      }
    },

    {
      "Sid": "S3ListBucketForSilverGoldModels",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::mlb-ai-datalake",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["silver/*", "gold/*", "models/*"]
        }
      }
    },

    {
      "Sid": "DenyWriteToBronzeSilver",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::mlb-ai-datalake/bronze/*",
        "arn:aws:s3:::mlb-ai-datalake/silver/*"
      ]
    },

    {
      "Sid": "MLflowReadModelRegistry",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::mlb-ai-datalake/mlflow-artifacts/*",
        "arn:aws:s3:::mlb-ai-datalake"
      ]
    },

    {
      "Sid": "CloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "MLB/AI/Inference"
        }
      }
    },

    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/mlb-ai/*"
    },

    {
      "Sid": "SSMParameterRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/mlb-ai/*"
    },

    {
      "Sid": "SecretsManagerReadApiToken",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:mlb-ai/api-token-*"
    },

    {
      "Sid": "SNSPublishDriftAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:*:*:mlb-ai-drift-alerts"
    },

    {
      "Sid": "DenyAllOtherS3Operations",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::mlb-ai-datalake/silver/*",
        "arn:aws:s3:::mlb-ai-datalake/gold/*",
        "arn:aws:s3:::mlb-ai-datalake/models/*",
        "arn:aws:s3:::mlb-ai-datalake/mlflow-artifacts/*",
        "arn:aws:s3:::mlb-ai-datalake"
      ]
    }
  ]
}
